@startuml
title GA - Блок-схема генетического алгоритма

start
:Получить project_id и параметры\n(alpha, beta, gamma, size, generations);
:Загрузить граф операций и длительности;

if (Операции найдены?) then (да)
  :Сформировать начальный genome;
  :Инициализировать популяцию;
  :Оценить fitness\nscore = alpha*T + beta*L + gamma*R;
  :Запомнить лучшее решение;

  while (Поколения не исчерпаны?) is (да)
    :Сортировка популяции по fitness;
    :Отбор лучших особей;
    :Кроссовер родителей;
    :Мутация потомков;
    :Обновление популяции;
    :Пересчет fitness и лучшего решения;
  endwhile (нет)

  :Построить итоговое расписание\nпо лучшему genome;
  :Вернуть best_fitness и schedule;
  stop
else (нет)
  :Вернуть пустой результат\n(best_fitness = 0);
  stop
endif

@enduml
